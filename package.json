{
  "name": "diagrampilot-ai",
  "version": "1.0.0",
  "description": "AI Architecture Assistant",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "npm install --prefix client && npm install --prefix server",

    "dev:client": "npm run dev --prefix client",
    "dev:server": "npm run dev --prefix server",
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",

    "build": "npm run build --prefix server && npm run build --prefix client",

    "lint": "npm run lint --prefix client",

    "typecheck": "cd server && tsc --noEmit"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
